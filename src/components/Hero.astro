---
// Hero: headline beside a slideshow of animated drawings.
// Each slide plays exactly one animation cycle, then crossfades to the next.
//
// The SVGs are inlined (not <img>) so the page can start each animation from frame 0 and know when it
// has finished. Their animations live in src/assets/hero/*.svg, gated on [data-playing] and finite.
// To add a slide: put an SVG in src/assets/hero/, import it with ?raw, and add it to SLIDES.
//   kind "wide": 1200×800 scene that leaves the left ~550px clear for the headline
//   kind "spot": 600×450 spot drawing, shown on the right half
import smith from "../assets/hero/smith.svg?raw";
import orion from "../assets/hero/orion.svg?raw";
import kestrel from "../assets/hero/kestrel.svg?raw";
import wren from "../assets/hero/wren.svg?raw";
import fieldnotes from "../assets/hero/fieldnotes.svg?raw";

type Slide = { key: string; kind: "wide" | "spot"; svg: string };
const SLIDES: Slide[] = [
  { key: "smith", kind: "wide", svg: smith },
  { key: "orion", kind: "spot", svg: orion },
  { key: "kestrel", kind: "spot", svg: kestrel },
  { key: "wren", kind: "spot", svg: wren },
  { key: "fieldnotes", kind: "spot", svg: fieldnotes },
];

// Inline SVGs share one document, so ids like "cA" or "fe" would clash between drawings.
// Prefix every id and every reference to it, and drop the embedded provenance manifest
// (the standalone files in public/art keep theirs).
function inline(svg: string, key: string) {
  const p = `hero-${key}-`;
  return svg
    .replace(/<metadata>[\s\S]*?<\/metadata>/, "")
    .replace(/\sxmlns:c2pa="[^"]*"/, "")
    .replace(/\sid="([^"]+)"/g, ` id="${p}$1"`)
    .replace(/url\(#([^)]+)\)/g, `url(#${p}$1)`)
    .replace(/href="#([^"]+)"/g, `href="#${p}$1"`)
    .replace(/<svg([^>]*?)\swidth="\d+"\sheight="\d+"/, "<svg$1"); // size comes from CSS
}
---

<section class="hero" aria-label="Introduction">
  <div class="stage" data-slideshow role="region" aria-roledescription="carousel" aria-label="Drawings from the workshop">
    {
      SLIDES.map((s, i) => (
        <div
          class:list={["slide", `slide--${s.kind}`, { "is-active": i === 0 }]}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${SLIDES.length}`}
          aria-hidden={i === 0 ? undefined : "true"}
          set:html={inline(s.svg, s.key)}
        />
      ))
    }
  </div>

  <div class="copy">
    <h1><span class="line">Robotics research,</span> <span class="line">built in the open.</span></h1>
    <p>An independent research lab building the next generation of open robots, and expanding access to robotics knowledge for builders worldwide.</p>
    <div class="ctas">
      <a href="#workbench" class="btn-outline">See the workbench</a>
      <a href="/log/">Read the log →</a>
    </div>
  </div>

  <div class="controls" data-slideshow-controls>
    {
      SLIDES.map((_, i) => (
        <button
          type="button"
          class="dot"
          data-go={i}
          aria-label={`Show drawing ${i + 1} of ${SLIDES.length}`}
          aria-current={i === 0 ? "true" : undefined}
        />
      ))
    }
    <button type="button" class="pause" data-toggle aria-pressed="false" hidden>Pause</button>
  </div>
</section>

<style>
  .hero { position: relative; height: 600px; overflow: hidden; }

  /* All slides are stacked in the same spot; only the active one is opaque. */
  .stage { position: absolute; inset: 0; }
  .slide { position: absolute; opacity: 0; transition: opacity .9s ease; }
  .slide.is-active { opacity: 1; }
  .slide :global(svg) { display: block; width: 100%; height: 100%; }

  .slide--wide { right: 0; top: -150px; width: 1200px; height: 800px; }
  /* Spot drawings sit on the right half, shrinking on narrower desktops so they never cover the headline. */
  .slide--spot { right: 40px; top: 72px; width: clamp(340px, calc(100% - 620px), 600px); aspect-ratio: 4 / 3; }

  .copy {
    position: absolute; left: var(--gutter); top: 64px; width: 500px;
    display: flex; flex-direction: column; gap: 22px;
  }
  /* Two lines on desktop: each half is its own line, and the size scales so the longer one always fits.
     The headline is wider than the paragraph; it sits above the top of the drawings. */
  h1 { font-size: clamp(48px, 5.6vw, 68px); line-height: 1.1; letter-spacing: -.012em; color: var(--ink); width: max-content; }
  h1 .line { display: block; white-space: nowrap; }
  .copy p { font-size: 15px; color: var(--text-2); max-width: 40ch; }
  .ctas { display: flex; gap: 16px; align-items: center; padding-top: 4px; font-size: 14px; }

  .controls {
    position: absolute; left: var(--gutter); bottom: 22px;
    display: flex; align-items: center; gap: 10px;
  }
  .dot {
    position: relative; width: 8px; height: 8px; padding: 0; border-radius: 50%;
    border: 1px solid var(--ink); background: #fff; cursor: pointer;
  }
  .dot[aria-current="true"] { background: var(--ink); }
  .dot::after { content: ""; position: absolute; inset: -10px; } /* bigger hit area, same look */
  .pause {
    margin-left: 8px; padding: 6px 0; border: 0; background: none; cursor: pointer;
    font: 11px var(--sans); color: var(--muted);
  }
  .pause:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
  }

  /* Tablet / phone: text first, drawing below it. */
  @media (max-width: 900px) {
    .hero { height: auto; display: flex; flex-direction: column; }
    .copy { position: static; width: auto; padding: 24px var(--gutter) 0; gap: 18px; order: 1; }
    /* Same two lines on phones; the size follows the screen width so line one always fits. */
    h1 { font-size: clamp(30px, 10.5vw, 64px); width: auto; }
    .stage { position: relative; inset: auto; order: 2; aspect-ratio: 4 / 3; overflow: hidden; margin-top: 8px; }
    /* Wide scenes: zoom in on the figure (it sits inside x 548–1042, y 336–713 of 1200×800). */
    .slide--wide { width: 208%; height: auto; aspect-ratio: 3 / 2; left: -87%; right: auto; top: -71%; }
    /* Spot drawings are already 4:3, so they fill the frame exactly. */
    .slide--spot { inset: 0; width: 100%; }
    .controls { position: static; order: 3; justify-content: center; padding: 8px var(--gutter) 16px; }
  }
</style>

<script>
  // Plays each slide's animation once, then moves on.
  // "Once" is measured, not timed: after starting a slide we ask the browser for every animation running
  // inside it (element.getAnimations) and wait until all of them have finished.
  const FADE_MS = 900;
  const FALLBACK_MS = 6000; // for a slide with no animation of its own

  function initSlideshow(stage: HTMLElement) {
    const slides = [...stage.querySelectorAll<HTMLElement>(".slide")];
    const controls = stage.parentElement!.querySelector<HTMLElement>("[data-slideshow-controls]")!;
    const dots = [...controls.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const toggle = controls.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let index = 0;
    let run = 0; // bumps on every slide change, so a stale "cycle finished" can't advance the show
    let userPaused = false;

    const animationsIn = (el: Element) => el.getAnimations({ subtree: true });

    function setActive(next: number) {
      const prev = slides[index];
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle("is-active", i === index);
        i === index ? s.removeAttribute("aria-hidden") : s.setAttribute("aria-hidden", "true");
      });
      dots.forEach((d, i) => (i === index ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      // The outgoing slide holds its last frame while it fades, then resets for next time.
      if (prev !== slides[index]) {
        setTimeout(() => { if (!prev.classList.contains("is-active")) prev.removeAttribute("data-playing"); }, FADE_MS);
      }
    }

    function play(next: number) {
      const thisRun = ++run;
      setActive(next);
      if (reducedMotion) return; // static drawings; visitors move with the dots

      const slide = slides[index];
      slide.removeAttribute("data-playing");
      void slide.offsetWidth; // force a style flush so the animations restart from frame 0
      slide.setAttribute("data-playing", "");

      let anims = animationsIn(slide).filter((a) => a.effect?.getComputedTiming().iterations !== Infinity);
      if (!anims.length) anims = [slide.animate([], { duration: FALLBACK_MS })];
      if (userPaused || document.hidden) anims.forEach((a) => a.pause());

      Promise.all(anims.map((a) => a.finished)).then(
        () => { if (run === thisRun) play(index + 1); },
        () => {}, // cancelled because the visitor jumped to another slide
      );
    }

    // Pausing freezes the drawing mid-cycle; resuming carries on from the same frame.
    function setPaused(paused: boolean) {
      animationsIn(stage).forEach((a) => {
        if (paused && a.playState === "running") a.pause();
        else if (!paused && a.playState === "paused") a.play();
      });
    }

    dots.forEach((d) => d.addEventListener("click", () => play(Number(d.dataset.go))));

    if (!reducedMotion) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        userPaused = !userPaused;
        toggle.textContent = userPaused ? "Play" : "Pause";
        toggle.setAttribute("aria-pressed", String(userPaused));
        setPaused(userPaused);
      });
      document.addEventListener("visibilitychange", () => setPaused(document.hidden || userPaused));
    }

    play(0);
  }

  document.querySelectorAll<HTMLElement>("[data-slideshow]").forEach(initSlideshow);
</script>
