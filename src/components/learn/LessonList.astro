---
// A project's lessons as numbered cards. Planned lessons are listed so readers see what's coming, but can't be opened.
import { getLessons, lessonUrl } from "../../lib/content";

interface Props { project: string }
const lessons = await getLessons(Astro.props.project);
---

{lessons.length === 0 ? (
  <p class="muted">No lessons yet.</p>
) : (
  <ol class="lessons">
    {lessons.map((l, i) => {
      const ready = l.data.status === "ready";
      const Tag = ready ? "a" : "div";
      return (
        <li>
          <Tag class:list={["card", { off: !ready }]} href={ready ? lessonUrl(l) : undefined}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <span class="body">
              <span class="q">{l.data.title}</span>
              <span class="sum">{l.data.summary}</span>
              {l.data.covers.length > 0 && (
                <span class="covers">{l.data.covers.map((c) => <span>{c}</span>)}</span>
              )}
            </span>
            <span class="go">{ready ? "Start →" : "Coming soon"}</span>
          </Tag>
        </li>
      );
    })}
  </ol>
)}

<style>
  .lessons { list-style: none; margin: 0; padding: 0; max-width: 860px; }
  .card {
    display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 4px 16px; align-items: baseline;
    padding: 20px 0; border-top: 1px solid var(--rule); color: var(--ink);
  }
  li:last-child .card { border-bottom: 1px solid var(--rule); }
  a.card:hover { text-decoration: none; }
  a.card:hover .q { color: var(--link); }
  .n { font: 13px var(--mono); color: var(--heat); }
  .off .n { color: var(--muted); }
  .body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .q { font-family: var(--serif); font-size: 22px; line-height: 1.25; }
  .off .q { color: var(--text-2); }
  .sum { font-size: 14px; color: var(--quote); max-width: 64ch; }
  .covers { display: flex; flex-wrap: wrap; gap: 6px; }
  .covers span { font-size: 11px; color: var(--muted); background: var(--chip); padding: 1px 8px; border-radius: 3px; }
  .go { font-size: 13px; color: var(--link); white-space: nowrap; }
  .off .go { color: var(--muted); font-size: 11px; background: var(--chip); padding: 1px 8px; border-radius: 3px; }
  @media (max-width: 560px) {
    .card { grid-template-columns: 32px minmax(0, 1fr); }
    .go { grid-column: 2; }
    .q { font-size: 19px; }
  }
</style>
