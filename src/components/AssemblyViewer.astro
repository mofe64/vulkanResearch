---
// A 3D view for step-by-step assembly guides. It loads one robot model and, for each step, shows only the
// printed parts that are in place by then, with the parts added in that step drawn in orange and sliding in.
//
// The page drives it: <assembly-viewer> listens for an "assembly-step" event on document whose detail is
// { parts: string[], focus: string[], from?: [x, y, z] mm, view?: "front" | "back" | "below", frame?: "focus" | "all" }.
// Parts are named by part number, the way the CAD names its files: "01" is OR21-01-base-shell,
// "04b" the yaw servo retainer, "22" all six joint caps, "10a"/"10b" the two halves of the lower arm. Bought parts
// use their model name without the "HW-" prefix: "servoyaw", "hornsshoulder", "camera", "led", "speaker". A "?capture" page uses window.assemblyViewer to
// render a still image of every step (scripts/assembly-stills.mjs).
interface Props { model: string; label: string }
const { model, label } = Astro.props;
---

<assembly-viewer class="av" data-model={model} role="img" aria-label={label}>
  <span class="av-hint" aria-hidden="true">Drag to turn · orange = added in this step</span>
</assembly-viewer>

<style>
  .av { display: block; position: relative; width: 100%; height: 100%; min-height: 320px; background: #fff; }
  .av :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; cursor: grab; touch-action: pan-y; }
  .av :global(canvas:active) { cursor: grabbing; }
  .av-hint { position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: var(--muted); pointer-events: none; z-index: 1; }
</style>

<script>
  import type { Mesh, Object3D, Vector3 as V3 } from "three";

  type StepState = {
    parts: string[];
    focus: string[];
    from?: [number, number, number];
    view?: "front" | "back" | "below";
    frame?: "focus" | "all"; // what the camera fits: the new parts (default) or everything shown
  };

  // Camera directions (model space, Y up; the lamp faces +Z).
  const VIEWS = { front: [1.1, 0.75, 1.5], back: [-1.1, 0.75, -1.5], below: [0.9, -1.2, 1.3] } as const;

  /** "OR21-04b-yaw-servo-retainer" -> "04b"; "OR21-22-elbow-left-..." -> "22". */
  const partNumber = (name: string) => name.toLowerCase().replace(/^[a-z]+\d*-/, "").split(/[-_ ]/)[0];

  class AssemblyViewer extends HTMLElement {
    private apply?: (s: StepState, instant?: boolean) => void;
    private pending?: StepState;

    connectedCallback() {
      document.addEventListener("assembly-step", (e) => {
        const s = (e as CustomEvent<StepState>).detail;
        this.apply ? this.apply(s) : (this.pending = s);
      });
      // Load three.js and the model only once the view is actually on screen (it is hidden on narrow screens).
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        this.mount().catch((err) => console.warn("[assembly-viewer]", err));
      });
      io.observe(this);
    }

    private async mount() {
      const THREE = await import("three");
      const { GLTFLoader } = await import("three/addons/loaders/GLTFLoader.js");
      const { OrbitControls } = await import("three/addons/controls/OrbitControls.js");
      const { MeshoptDecoder } = await import("three/addons/libs/meshopt_decoder.module.js");
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const capture = new URLSearchParams(location.search).has("capture");

      const gltf = await new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).loadAsync(this.dataset.model!);
      const model = gltf.scene;

      // Same "ink" look as the project viewer, plus an orange version for the parts being added.
      const surface = new THREE.MeshLambertMaterial({ color: 0xffffff, polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 });
      const surfaceNew = new THREE.MeshLambertMaterial({ color: 0xf6d2c0, polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 });
      const line = new THREE.LineBasicMaterial({ color: 0x3b3632 });
      const lineNew = new THREE.LineBasicMaterial({ color: 0xb8471b });
      // Bought parts (servos, horns, camera, LEDs, speaker) are light grey, so they read apart from the prints.
      const surfaceBought = new THREE.MeshLambertMaterial({ color: 0xcfd0d2, polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 });
      const isBought = (num: string) => !/^\d/.test(num);

      type Part = { obj: Mesh; num: string; edges: Object3D; home: V3 };
      const parts: Part[] = [];
      model.traverse((o) => {
        if (!(o as Mesh).isMesh) return;
        const mesh = o as Mesh;
        const edges = new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry, 30), line);
        mesh.add(edges);
        // gltfpack may name the mesh itself generically ("mesh"); the part name is on the nearest named node.
        let named: Object3D | null = mesh;
        while (named && !/^[a-z]+\d*-/i.test(named.name)) named = named.parent;
        parts.push({ obj: mesh, num: partNumber(named?.name ?? ""), edges, home: mesh.position.clone() });
      });

      // Work in millimetres-ish units: centre the whole lamp and scale it to about 1 unit tall.
      const all = new THREE.Box3().setFromObject(model);
      const centre = all.getCenter(new THREE.Vector3());
      const unit = Math.max(...all.getSize(new THREE.Vector3()).toArray()) || 1;
      model.position.sub(centre);
      const pivot = new THREE.Group();
      pivot.add(model);
      pivot.scale.setScalar(1 / unit);

      const scene = new THREE.Scene();
      scene.add(pivot);
      scene.add(new THREE.HemisphereLight(0xffffff, 0xd9d6cf, 2.2));
      const sun = new THREE.DirectionalLight(0xffffff, 0.8);
      sun.position.set(2, 3, 2);
      scene.add(sun);

      const camera = new THREE.PerspectiveCamera(32, 4 / 3, 0.01, 100);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: capture });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      this.prepend(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableZoom = false; // keep the page scrollable with the wheel
      controls.enablePan = false;
      controls.enableDamping = true;

      let last: StepState | null = null;
      const resize = () => {
        renderer.setSize(this.clientWidth, this.clientHeight, false);
        camera.aspect = this.clientWidth / Math.max(1, this.clientHeight);
        camera.updateProjectionMatrix();
        if (last) this.apply?.(last, true); // re-frame for the new shape
      };
      new ResizeObserver(resize).observe(this);
      resize();

      // Camera moves and part slides are eased between their start and end over DURATION.
      const DURATION = reducedMotion || capture ? 0 : 900;
      let anim: { t0: number; fromPos: V3; toPos: V3; fromTarget: V3; toTarget: V3 } | null = null;
      const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

      this.apply = (s, instant = false) => {
        last = s;
        for (const p of parts) p.obj.position.copy(p.home);
        pivot.updateMatrixWorld(true);
        const show = new Set(s.parts);
        const focus = new Set(s.focus);
        // Slide-in offset: mm in the model -> metres -> scene units (the lamp is scaled to about 1 unit).
        const from = new THREE.Vector3(...(s.from ?? [0, 60, 0])).multiplyScalar(0.001 / unit);

        for (const p of parts) {
          const visible = show.has(p.num) || focus.has(p.num);
          const isNew = focus.has(p.num);
          p.obj.visible = visible;
          p.obj.material = isNew ? surfaceNew : isBought(p.num) ? surfaceBought : surface;
          (p.edges as unknown as { material: unknown }).material = isNew ? lineNew : line;
          // The slide offset is given in model (world) axes; parts under a joint need it in their parent's axes.
          (p.obj.userData as { offset?: V3 }).offset = isNew && DURATION && !instant
            ? p.obj.parent!.worldToLocal(p.obj.parent!.localToWorld(p.home.clone()).add(from)).sub(p.home)
            : undefined;
        }

        // Frame the new parts, or everything shown when nothing is new.
        const box = new THREE.Box3();
        const fitAll = focus.size === 0 || s.frame === "all";
        for (const p of parts) if (p.obj.visible && (fitAll || focus.has(p.num))) box.expandByObject(p.obj);
        if (box.isEmpty()) box.setFromObject(pivot);
        const target = box.getCenter(new THREE.Vector3());
        // Half the box diagonal over-estimates how much room a tall, thin shape needs; 0.8 of it frames snugly.
        const radius = Math.max((box.getSize(new THREE.Vector3()).length() / 2) * 0.8, 0.14);
        const dir = new THREE.Vector3(...VIEWS[s.view ?? "front"]).normalize();
        const fit = radius / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2)) * (camera.aspect < 1 ? 1.35 : 1.05);
        const toPos = target.clone().add(dir.multiplyScalar(fit));

        if (DURATION && !instant) {
          anim = { t0: performance.now(), fromPos: camera.position.clone(), toPos, fromTarget: controls.target.clone(), toTarget: target };
        } else {
          anim = null;
          camera.position.copy(toPos);
          controls.target.copy(target);
        }
        controls.update();
        tick();
      };

      const tick = () => {
        if (anim) {
          const t = Math.min(1, (performance.now() - anim.t0) / DURATION);
          const k = ease(t);
          camera.position.lerpVectors(anim.fromPos, anim.toPos, k);
          controls.target.lerpVectors(anim.fromTarget, anim.toTarget, k);
          for (const p of parts) {
            const off = (p.obj.userData as { offset?: V3 }).offset;
            if (off) p.obj.position.copy(p.home).addScaledVector(off, 1 - k);
          }
          if (t >= 1) anim = null;
        }
        controls.update();
        renderer.render(scene, camera);
      };
      new IntersectionObserver(([e]) => renderer.setAnimationLoop(e.isIntersecting ? tick : null)).observe(this);

      // Stills: the capture script calls setStep(state) and screenshots the canvas once it returns.
      (window as unknown as { assemblyViewer: unknown }).assemblyViewer = {
        setStep: (s: StepState) => { this.apply!(s, true); renderer.render(scene, camera); return true; },
        partNumbers: () => [...new Set(parts.map((p) => p.num))], // which part numbers the model has, for checking a guide
      };

      this.apply(this.pending ?? { parts: [...new Set(parts.map((p) => p.num))], focus: [] }, true);
      this.classList.add("is-ready");
    }
  }

  if (!customElements.get("assembly-viewer")) customElements.define("assembly-viewer", AssemblyViewer);
</script>
